# Backend Environment Variables
# Copy this to .env and adjust values as needed

# Server Configuration
PORT=8000
DEBUG=true

# CORS Origins (comma-separated)
# Production: Add your Netlify frontend URL here
# CORS_ORIGINS=https://your-frontend.netlify.app,http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite:///./thermalift.db

# Synthetic Data
SYNTHETIC_DATA_SEED=42
DEMO_MODE=true